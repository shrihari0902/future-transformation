```gitignore
# Python
__pycache__/
*.py[cod]
.venv/
venv/
backend/venv/
.pytest_cache/

# Node.js
node_modules/
frontend/node_modules/
frontend/dist/

# Environment and databases
.env
*.sqlite
*.sqlite3
*.db

# Gradle and build artifacts
.gradle/
**/.gradle/
build/
**/build/

# Private keys
backend/keys/*.pem
!backend/keys/.gitkeep

# IDE and OS files
.DS_Store
.vscode/
.idea/
.antigravity-ide/
```